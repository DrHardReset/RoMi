<Project Sdk="Uno.Sdk">
  <!-- Basic settings -->
  <PropertyGroup>
    <ApplicationTitle>RoMi</ApplicationTitle>
    <ApplicationId>com.DrHardReset.RoMi</ApplicationId>
    <ApplicationPublisher>DrHardReset</ApplicationPublisher>
    <Description>RoMi: Calculates SysEx MIDI messages for Roland Keyboards.</Description>
	  <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!--
    Do not reference the development-time packages Uno.UI.App.Mcp as it would lead to conflicts with different versions of SkiaSharp.
    SkiaSharp is currently not used for the windows build.
    -->
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks Condition="'$(Configuration)'!='Test'">net10.0-android;net10.0-ios;net10.0-desktop;net10.0-windows10.0.19041;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(Configuration)'=='Test'">net10.0</TargetFrameworks>
    <Platforms>AnyCPU;x64</Platforms>
    <Configurations>Debug;Release;Test</Configurations>

    
    <!-- Do not autogenerate AssemblyInfo as github workflow will set the version number in the static AssemblyInfo.cs automatically. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Dsp;
      Toolkit;
      Logging;
      Mvvm;
      Configuration;
      Http;
      Localization;
      Navigation;
      ThemeService;
    </UnoFeatures>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release' And $(TargetFramework.Contains('windows'))">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug' And $(TargetFramework.Contains('android'))">
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore>false</AndroidKeyStore>
    <AndroidUseAapt2>true</AndroidUseAapt2>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release' And $(TargetFramework.Contains('android'))">
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore>false</AndroidKeyStore>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <AndroidLinkTool>r8</AndroidLinkTool>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="managed-midi" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <!-- The net10.0 target has no Uno runtime host (used by the unit tests), but the generated ICU initializer still needs
       the native ICU library and the embedded icudt.dat. Since Uno 7 they only come with a runtime host. -->
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PackageReference Include="Uno.icu-win" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\LibraryDependencyReport.json" />
    <EmbeddedResource Include="Assets\LibraryDependencyReport.json" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectCapability Include="Maui" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Uno.Extensions.Localization" RootMode="EntryPoint" />
    <TrimmerRootAssembly Include="Uno.Extensions.Navigation" RootMode="EntryPoint" />
    <TrimmerRootAssembly Include="Uno.Extensions.Configuration" RootMode="EntryPoint" />
    <TrimmerRootAssembly Include="RoMi" RootMode="EntryPoint" />
  </ItemGroup>

  <!-- Only create the library dependency report once for all platforms directly after restoring nuget packages.
       Unfortunatelly the targets for building in VS and dotnet build seem to differ.
       That is why I defined two targets. -->
  <Target Name="CreateLibraryDependencyReport_VisualStudio" BeforeTargets="DispatchToInnerBuilds">
    <Exec Command="dotnet tool restore" />
    <Exec Command="powershell.exe -NoLogo -NonInteractive -executionpolicy Unrestricted &quot;&amp; '.\createLibraryDependencyReport.ps1' '$(SolutionDir)\RoMi.sln' '$(MSBuildProjectDirectory)\Assets\LibraryDependencyReport.json'&quot;" />
  </Target>

  <Target Name="CreateLibraryDependencyReport_DotnetBuild" AfterTargets="Restore">
     <!--dotnet build works with "$(ProjectDir)..\" instead of "$(SolutionDir)"-->
    <Exec Command="dotnet tool restore" />
    <Exec Command="powershell.exe -NoLogo -NonInteractive -executionpolicy Unrestricted &quot;&amp; '.\createLibraryDependencyReport.ps1' '$(ProjectDir)..\RoMi.sln' '$(MSBuildProjectDirectory)\Assets\LibraryDependencyReport.json'&quot;" />
  </Target>

  <Import Project="build/Warnings.targets" />

</Project>
