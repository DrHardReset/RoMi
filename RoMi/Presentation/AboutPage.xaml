<Page x:Class="RoMi.Presentation.AboutPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:RoMi.Presentation"
	xmlns:conv="using:RoMi.Presentation.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:uen="using:Uno.Extensions.Navigation.UI"
	xmlns:utu="using:Uno.Toolkit.UI"
	NavigationCacheMode="Required"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
  </Page.Resources>

  <Grid utu:SafeArea.Insets="All">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <utu:NavigationBar Content="About RoMi"
											 Grid.Row="0">
      <utu:NavigationBar.MainCommand>
        <AppBarButton>
          <AppBarButton.Icon>
            <BitmapIcon UriSource="ms-appx:///Assets/Images/back.png" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <StackPanel Grid.Row="1"
			        	HorizontalAlignment="Center"
						    VerticalAlignment="Top">

      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{Binding Title}" HorizontalAlignment="Center"/>
      <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Copyright (C) 2023 - 2026 Johannes Brallentin" HorizontalAlignment="Center"/>
      <TextBlock Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center">
				<Span xml:space="preserve"><Run>This program is free software licensed under the </Run><Hyperlink NavigateUri="https://github.com/DrHardReset/RoMi/blob/master/LICENSE.md">GNU General Public License v3</Hyperlink><Run>.</Run></Span>
      </TextBlock>
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <StackPanel HorizontalAlignment="Center"
									Margin="0,50,0,0">

        <TextBlock Style="{StaticResource TitleTextBlockStyle}"
					  	  	 Text="Used Libraries:"/>

        <ItemsControl ItemsSource="{Binding Packages}"
        		          HorizontalAlignment="Center">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" MinWidth="20" />
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <HyperlinkButton Grid.Column="0"
								  		           Padding="0"
								  		           NavigateUri="{Binding PackageProjectUrl}"
								  		           Content="{Binding PackageId}"
								  		           Visibility="{Binding PackageProjectUrl, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Grid.Column="0"
								           Text="{Binding PackageId}"
								           Visibility="{Binding PackageProjectUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}" />

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding PackageVersion}" />
                <HyperlinkButton Grid.Column="3"
                                 HorizontalAlignment="Right"
                                 HorizontalContentAlignment="Right"
                                 Padding="4,0"
                                 MaxWidth="160"
                                 NavigateUri="{Binding LicenseUrl}"
                                 ToolTipService.ToolTip="{Binding LicenseDisplay}">
                  <TextBlock Text="{Binding LicenseDisplay}"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap"
                             MaxWidth="150" />
                </HyperlinkButton>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
